# Clause gateway configuration. Copy to .env (repo root). Real environment variables win.
# With no .env at all, `npm run dev` runs in SIMULATED mode with locally generated dev keys.

# ── Mode ───────────────────────────────────────────────────────────────
# simulated: SQLite ledger mirroring ClauseEscrow + reference-model verdicts. No chain, no wallet.
# chain:     the deployed ClauseEscrow (verdicts from the registered processor).
SETTLEMENT_MODE=simulated
PORT=8787
PUBLIC_URL=http://localhost:8787
WEB_URL=http://localhost:5173
# DB_PATH=packages/gateway/data/clause.db
# NODE_ENV=production            # also flips ALLOW_PRIVATE_UPSTREAMS to false by default

# ── Keys (chain mode: required; simulated: optional, generated + stored in the DB) ──
# GATEWAY_PRIVATE_KEY=0x…        # attests arrival/statusOK; must equal Service.gateway
# CRANK_PRIVATE_KEY=0x…          # pays gas for settleBatch/reclaim (defaults to the gateway key)
# SELLER_PRIVATE_KEY=0x…         # demo FX seller's signing key (must equal Service.signer)
# DEMO_FUNDER_PRIVATE_KEY=0x…    # chain-mode faucet for the wallet-free sandbox (holds TOKEN, pays gas)

# ── Chain (or set DEPLOYMENT_FILE to the JSON written by the deploy script) ──
# DEPLOYMENT_FILE=packages/contracts/deployments/xlayer.json
# CHAIN_ID=196
# RPC_URL=https://rpc.xlayer.tech
# ESCROW_ADDRESS=0x…
# TOKEN_ADDRESS=0x…              # PRD §9 #5: canonical USDC, else USDT/USDG
# TOKEN_SYMBOL=USDT
# TOKEN_DECIMALS=6
# EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer

# ── TapeOut / "Tape X" (partner-provided) ─────────────────────────────
# PROCESSOR_ADDRESS=0x…
# CIRCUIT_ID_E=…
# CIRCUIT_ID_B=…
# TAPEOUT_URL_E=https://…
# TAPEOUT_URL_B=https://…

# ── Demo seller + sandbox ─────────────────────────────────────────────
DEMO_SELLER_EMBEDDED=true
DEMO_SELLER_PORT=4100
DEMO_SELLER_ADMIN_PORT=4101
# DEMO_SELLER_URL=http://127.0.0.1:4100
# DEMO_SELLER_ADMIN_URL=http://127.0.0.1:4101
DEMO_SELLER_AUTO_REVIVE_MS=120000
DEMO_ALLOW_GLOBAL_KILL=true
DEMO_FUND_AMOUNT=1000000          # 1.00 at 6 decimals
DEMO_PRICE=10000                  # 0.01 (simulated mode)
DEMO_GRACE=5
DEMO_SLA_SECONDS=3
DEMO_TOLERANCE_BPS=5

# ── Crank / vouchers / safety ─────────────────────────────────────────
# CRANK_INTERVAL_MS=2000
VOUCHER_TTL_SECONDS=120           # ≤ 600 (ClauseEscrow.MAX_VOUCHER_LIFETIME)
# ALLOW_PRIVATE_UPSTREAMS=true    # false in production: blocks SSRF to private/loopback upstreams
# CRANK_TOKEN=…                   # if set, POST /internal/crank requires "Authorization: Bearer …"
SERVE_WEB_DIST=true               # serve packages/web/dist from the gateway (single-process deploy)

# ── Contracts deploy (packages/contracts) ─────────────────────────────
# DEPLOYER_PRIVATE_KEY=0x…
# XLAYER_RPC_URL=https://rpc.xlayer.tech
# TREASURY_ADDRESS=0x…
# FEE_BPS=100
# PRICE=10000
# GRACE=5
# REGISTER_DEMO_SERVICES=true
# GATEWAY_ADDRESS=0x…
# SELLER_SIGNER=0x…
# SELLER_PAYEE=0x…

# ── Frontend build ────────────────────────────────────────────────────
# VITE_GATEWAY_URL=https://gateway.example.com   # when the web build is hosted separately (DeWEB/TapeKit)
